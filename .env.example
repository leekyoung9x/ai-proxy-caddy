# Freebuff adapter credentials (local only; never commit this file)
FREEBUFF_TOKEN=
FREEBUFF_USER_ID=

# CodeBuddy / WorkBuddy adapter credentials (local only; never commit this file)
# Lấy token: chạy CLI `codebuddy` -> /login (device flow).
# Token nằm ở ~/.codebuddy/auth_token.json (khoá accessToken, uid ở /v2/plugin/account).
# expiresIn ~365 ngày nên không cần refresh logic.
CODEBUDDY_TOKEN=
CODEBUDDY_USER_ID=
# Model công bố ra /v1/models (mặc định 2 model free vĩnh viễn)
CODEBUDDY_MODELS=hy3,deepseek-v4.1-flash
